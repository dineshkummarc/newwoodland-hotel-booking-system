APP_NAME="Newwoodland Hotel and Lounge"
# PRODUCTION DEPLOYMENT: set APP_ENV=production, APP_DEBUG=false, and
# APP_URL to the live domain (https://...) before going live. Leaving
# APP_DEBUG=true in production leaks stack traces/config to visitors.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Local development can use either driver below. This project was developed
# against MySQL; switch DB_CONNECTION to sqlite for a zero-setup local DB.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newwoodland_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set SESSION_SECURE_COOKIE=true once the site is served over
# HTTPS, so session/admin-login cookies are never sent over plain HTTP.
# Leave unset for local development (no HTTPS).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL ---
# Local/dev: MAIL_MAILER=log writes emails to storage/logs/laravel.log instead
# of sending them, so booking/contact notifications can be inspected safely.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@newwoodlandhotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PRODUCTION SMTP (example) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.yourprovider.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_ENCRYPTION=tls

# --- ESEWA PAYMENT GATEWAY ---
# These are eSewa's own publicly published UAT/sandbox test credentials
# (developer.esewa.com.np) — safe defaults for development only. Before
# accepting real payments, set ESEWA_MODE=production and replace
# ESEWA_PRODUCT_CODE / ESEWA_SECRET_KEY with your real merchant
# credentials issued by eSewa. Never commit real production values.
ESEWA_MODE=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# --- KHALTI PAYMENT GATEWAY (real integration code, not yet configured) ---
# KhaltiPaymentService is fully implemented against Khalti's documented
# e-Payment API (https://docs.khalti.com/khalti-epayment/), but unlike
# eSewa's EPAYTEST, Khalti has no publicly shared sandbox key — every
# merchant (sandbox included) must sign up at test-admin.khalti.com and use
# the live_secret_key issued there. Leave KHALTI_SECRET_KEY unset and
# KHALTI_ENABLED=false until a real sandbox or production key exists; never
# put a fake value here.
KHALTI_ENABLED=false
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=

# --- FONEPAY / BANK TRANSFER (NOT YET INTEGRATED) ---
# Both require formal merchant onboarding (Fonepay: through your acquiring
# bank; Bank Transfer: real account details from the client) before any
# integration — no public self-serve test environment exists for either.
# Shown on the checkout page as "coming soon" until then.
FONEPAY_ENABLED=false
BANK_TRANSFER_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
