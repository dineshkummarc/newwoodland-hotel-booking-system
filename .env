APP_NAME="Newwoodland Hotel & Lounge"
# PRODUCTION DEPLOYMENT: set APP_ENV=production, APP_DEBUG=false, and
# APP_URL to the live domain (https://...) before going live. Leaving
# APP_DEBUG=true in production leaks stack traces/config to visitors.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Local development can use either driver below. This project was developed
# against MySQL; switch DB_CONNECTION to sqlite for a zero-setup local DB.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newwoodland_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookies are HTTPS-only automatically whenever APP_URL starts with
# https:// (config/session.php). SESSION_SECURE_COOKIE overrides that.
# SESSION_SECURE_COOKIE=true

# --- TRUSTED PROXIES (config/trustedproxy.php, docs/DEPLOYMENT.md §9) ---
# Leave EMPTY if PHP/nginx faces the internet directly. If a reverse proxy,
# load balancer or Cloudflare terminates HTTPS in front of the app, list ONLY
# that proxy's IPs/CIDRs (comma-separated), e.g. 127.0.0.1 for nginx on the
# same server, or Cloudflare's published ranges. Getting this wrong makes all
# visitors share one rate limit and breaks signed email links.
TRUSTED_PROXIES=

# --- HSTS (HTTP Strict Transport Security) ---
# See config/security.php. Leave off for local HTTP development. In
# production, enable only once HTTPS works for the whole domain; start with a
# short HSTS_MAX_AGE (e.g. 300) and raise it to 31536000 once stable. The
# header is only ever sent on HTTPS requests.
HSTS_ENABLED=false
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=false
# HSTS_PRELOAD=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL ---
# Local/dev: MAIL_MAILER=log writes emails to storage/logs/laravel.log instead
# of sending them, so booking/contact notifications can be inspected safely.
# With APP_ENV=production a log mailer drops every email and logs an error.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="woodlandhotel146@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PRODUCTION SMTP (example) ---
# Booking/cancellation/contact emails are QUEUED (QUEUE_CONNECTION above), so
# production also needs a running queue worker — see docs/DEPLOYMENT.md.
# MAIL_SCHEME is "smtps" for implicit TLS on port 465; leave it null for
# STARTTLS on port 587 (negotiated automatically).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.yourprovider.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM_ADDRESS=bookings@your-domain.com

# --- ESEWA PAYMENT GATEWAY ---
# These are eSewa's own publicly published UAT/sandbox test credentials
# (developer.esewa.com.np) — safe defaults for development only. Before
# accepting real payments, set ESEWA_MODE=production and replace
# ESEWA_MERCHANT_CODE / ESEWA_SECRET_KEY with your real merchant
# credentials issued by eSewa. Never commit real production values.
# Accepted by the hotel. PRODUCTION SAFETY: with APP_ENV=production, eSewa is
# switched OFF (hidden at checkout, refused if posted to, never confirms
# anything) unless ESEWA_MODE=production AND real, non-public credentials are
# set — a copied sandbox config can never take "payments" on the live site.
# Run `php artisan payments:check-config` on the server before go-live.
# Required in production:
#   ESEWA_MODE=production
#   ESEWA_MERCHANT_CODE=<your live merchant code>
#   ESEWA_SECRET_KEY=<your live secret key>
ESEWA_ENABLED=true
ESEWA_MODE=sandbox
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# --- KHALTI PAYMENT GATEWAY (e-Payment Web Checkout) ---
# https://docs.khalti.com/khalti-epayment/
# The key below is the example key printed in Khalti's own public docs; the
# Khalti SANDBOX (dev.khalti.com) accepts it, so — like eSewa's EPAYTEST —
# it's a safe default for development only. Sandbox test wallet: Khalti ID
# 9800000000–9800000005, MPIN 1111, OTP 987654.
# PRODUCTION: set KHALTI_MODE=production and replace KHALTI_SECRET_KEY with
# YOUR live_secret_key from admin.khalti.com (the app refuses the public
# example key in production mode). Never commit real production values.
# The hotel does NOT accept Khalti: config/payments.php hard-disables it, so
# this flag has no effect (kept only for reference).
KHALTI_ENABLED=false
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455

# --- FONEPAY PAYMENT GATEWAY ---
# FonepayPaymentService is implemented against Fonepay's published web-payment
# protocol (see docs/PAYMENTS.md). Fonepay issues a merchant code + secret key
# per merchant: use the DEV merchant portal (dev-merchant-login.fonepay.com)
# credentials with FONEPAY_MODE=sandbox, and the LIVE portal (login.fonepay.com)
# credentials with FONEPAY_MODE=production.
# Fonepay is only shown at checkout once both values are set; never put a fake value
# here, and never commit real ones. FONEPAY_CURRENCY is Fonepay's CRN field.
# With APP_ENV=production it additionally requires FONEPAY_MODE=production
# (same safety rule as eSewa). If the hotel isn't using Fonepay yet, set
# FONEPAY_ENABLED=false so payments:check-config doesn't report it.
FONEPAY_ENABLED=true
FONEPAY_MODE=sandbox
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
FONEPAY_CURRENCY=NPR

# --- BANK TRANSFER (manual payment) ---
# No gateway: the guest transfers to the hotel's account and staff confirm
# receipt in the admin (booking page → "Confirm Bank Transfer Received").
# The bank name/account name/account number/branch are NOT configured here —
# they are ordinary hotel data an admin enters on Admin → Settings → "Bank
# Transfer Details" (stored on the settings table). Offered at checkout only
# when BANK_TRANSFER_ENABLED=true AND that Settings record actually has an
# account number filled in (Siddhartha Bank). HOLD_HOURS is how long the room is held
# for a guest who chose this method (online gateways use the normal
# 30-minute hold). INSTRUCTIONS is optional free text shown alongside the
# account details.
BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_HOLD_HOURS=24
BANK_TRANSFER_INSTRUCTIONS=

# --- SMS (phone verification + password recovery codes) ---
# See docs/SMS.md. SMS_DRIVER=log (default) writes messages — including the
# 6-digit codes — to storage/logs/laravel.log for local development only; it
# never records message bodies and fails every send when APP_ENV=production. Use
# SMS_DRIVER=sparrow in production with credentials from
# https://web.sparrowsms.com (Nepal numbers only). SPARROW_SMS_FROM is the
# sender identity Sparrow approved for your account. Leave the token unset
# until real credentials exist; never commit real values.
SMS_DRIVER=log
SMS_DEFAULT_REGION=NP
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=
# SPARROW_SMS_URL=https://api.sparrowsms.com/v2/sms/

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- PAYMENT POLICY ---
# Hotel policy: 100% paid in advance (QR / online), OR 50% in advance + 50%
# paid at the hotel ("Pay at Hotel"). Paying the full amount at the hotel is
# not offered, so the checkout "cash" option is hard-wired off in
# config/payments.php. Staff record the at-hotel balance on arrival
# (Admin → Booking → "Record Cash Payment"). CASH_HOLD_HOURS only applies to
# older bookings that chose cash.
CASH_HOLD_HOURS=24

# --- BOOKING LIMITS (config/bookings.php) ---
# Abuse guard: rooms one guest (same email/phone/account) may hold UNPAID at
# once on the public site. Default 5 = the largest single booking, so groups
# can always book in one go.
# BOOKING_MAX_UNPAID_HELD_ROOMS_PER_GUEST=5
# Technical safety limits — CLIENT DECISION REQUIRED for the real values:
# how far ahead guests may book, and the longest stay bookable online.
# BOOKING_MAX_ADVANCE_DAYS=730
# BOOKING_MAX_NIGHTS=90

# --- SPLIT PAYMENT (pay part now, the rest at the hotel) ---
# OFF by default: the hotel requires 100% advance payment for advance
# bookings (client-confirmed). Only enable if the hotel changes that policy.
# SPLIT_PAYMENT_ENABLED=false
# SPLIT_PAYMENT_PERCENT=50

# --- CHECK-IN REMINDER EMAIL ---
# See config/bookings.php. Sent (queued) once per confirmed booking by the
# hourly bookings:send-checkin-reminders schedule — needs the scheduler AND
# a queue worker in production.
CHECKIN_REMINDER_ENABLED=true
CHECKIN_REMINDER_DAYS_BEFORE=1

# --- GUEST PHOTO ID ---
# Hotel policy: every guest presents a photo ID at check-in — Citizenship,
# Student ID or Office/Company ID.
# CHECKIN_REQUIRES_PHOTO_ID: staff must confirm it before checking a guest in.
# GUEST_DOCUMENTS_ENABLED: staff may record the ID type/number on the booking
# page (number encrypted at rest with APP_KEY — keep it backed up and never
# rotate it without re-encrypting; see docs/DEPLOYMENT.md).
# ID scans are never stored (hotel policy; hard-wired off in config/bookings.php).
CHECKIN_REQUIRES_PHOTO_ID=true
GUEST_DOCUMENTS_ENABLED=true

# --- PAYMENT TESTING ---
# For testing only, put any personal sandbox/OTP credentials in your own .env
# (never in this file or in code), and remove them before going live.
